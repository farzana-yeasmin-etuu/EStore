<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Ever Spring</title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         EXISTING PROJECT CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         ESTORE GENERATED CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/EStore.styles.css"
          asp-append-version="true" />


    <!-- =====================================================
         EVER SPRING CSS
         MUST BE LAST
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/ever-spring.css"
          asp-append-version="true" />

</head>


<body>

      <div class="ever-sticky-navigation">
    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header>


        <!-- =================================================
             STICKY NAVIGATION WRAPPER
             ================================================= -->

      


            <!-- =================================================
                 TOP NAVBAR
                 ================================================= -->

            <nav class="ever-navbar">

                <div class="container">

                    <div class="ever-navbar-top">


                        <!-- ====================================
                             LEFT - LOGO
                             ==================================== -->

                        <a class="ever-logo"
                           asp-controller="Home"
                           asp-action="Index"
                           aria-label="Ever Spring Home">

                            <img src="~/images/ever-spring-logo.png"
                                 alt="Ever Spring Logo" />

                        </a>


                        <!-- ====================================
                             CENTER - BRAND
                             ==================================== -->

                        <a class="ever-brand-centered"
                           asp-controller="Home"
                           asp-action="Index">

                            Ever Spring

                        </a>


                        <!-- ====================================
                             MOBILE HAMBURGER
                             ==================================== -->

                        <button class="ever-menu-toggle"
                                type="button"
                                id="everMenuToggle"
                                aria-label="Open navigation menu"
                                aria-controls="everMobileMenu"
                                aria-expanded="false">

                            <span></span>
                            <span></span>
                            <span></span>

                        </button>


                        <!-- =================================================
                             DESKTOP NAVIGATION ACTIONS
                             ================================================= -->

                        <div class="ever-nav-actions">


                            <!-- =========================================
                                 SEARCH
                                 ========================================= -->

                            <a class="ever-icon-link"
                               asp-controller="Products"
                               asp-action="Search"
                               aria-label="Search">

                                <span class="ever-icon">
                                    ⌕
                                </span>

                                <span class="action-label">
                                    Search
                                </span>

                            </a>


                            <!-- =========================================
                                 WISHLIST
                                 ========================================= -->

                            <a class="ever-icon-link es-nav-icon-link"
                               asp-controller="Products"
                               asp-action="Wishlist"
                               aria-label="Wishlist">

                                <span class="es-nav-icon">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M20.8 8.7c0 5.2-8.8 10.2-8.8 10.2S3.2 13.9 3.2 8.7A4.7 4.7 0 0 1 12 6.3a4.7 4.7 0 0 1 8.8 2.4Z">
                                        </path>

                                    </svg>


                                    <!-- Wishlist Count -->

                                    <span class="es-nav-badge"
                                          id="wishlistCount">
                                    </span>

                                </span>

                            </a>


                            <!-- =========================================
                                 SHOPPING BAG
                                 ========================================= -->

                            <a class="ever-icon-link es-nav-icon-link"
                               asp-controller="Products"
                               asp-action="Cart"
                               aria-label="Shopping Bag">

                                <span class="es-nav-icon">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M6 8h12l1 13H5L6 8Z">
                                        </path>

                                        <path d="M9 8a3 3 0 0 1 6 0">
                                        </path>

                                    </svg>


                                    <!-- Cart Count -->

                                    <span class="es-nav-badge"
                                          id="cartCount">
                                    </span>

                                </span>

                            </a>


                            <!-- =================================================
                                 ADMIN / ACCOUNT / LOGIN
                                 ================================================= -->

                            @if (User.Identity?.IsAuthenticated == true)
                            {

                                <!-- ADMIN -->

                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="ever-icon-link"
                                       asp-controller="Admin"
                                       asp-action="Index"
                                       aria-label="Admin Dashboard">

                                        <span class="ever-icon">
                                            ⚙
                                        </span>

                                        <span class="action-label">
                                            Admin
                                        </span>

                                    </a>
                                }


                                <!-- ACCOUNT -->

                                <a class="ever-icon-link"
                                   asp-controller="Account"
                                   asp-action="Profile"
                                   aria-label="My Account">

                                    <span class="ever-icon">
                                        ♙
                                    </span>

                                    <span class="action-label">
                                        Account
                                    </span>

                                </a>


                                <!-- LOGOUT -->

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="ever-logout-form">

                                    <button type="submit"
                                            class="ever-icon-link">

                                        <span class="action-label">
                                            Logout
                                        </span>

                                    </button>

                                </form>

                            }
                            else
                            {

                                <!-- LOGIN -->

                                <a class="ever-icon-link"
                                   asp-controller="Account"
                                   asp-action="Login"
                                   aria-label="Login">

                                    <span class="ever-icon">
                                        ♙
                                    </span>

                                    <span class="action-label">
                                        Login
                                    </span>

                                </a>

                            }


                        </div>


                        <!-- =================================================
                             MOBILE MENU
                             ================================================= -->

                        <div class="ever-mobile-menu"
                             id="everMobileMenu">


                            <!-- =========================================
                                 MOBILE ACTIONS
                                 ========================================= -->

                            <div class="ever-mobile-menu-actions">


                                <!-- SEARCH -->

                                <a class="ever-mobile-link"
                                   asp-controller="Products"
                                   asp-action="Search">

                                    <span class="ever-mobile-icon">
                                        ⌕
                                    </span>

                                    Search

                                </a>


                                <!-- WISHLIST -->

                                <a class="ever-mobile-link"
                                   asp-controller="Products"
                                   asp-action="Wishlist">

                                    <span class="ever-mobile-icon">
                                        ♡
                                    </span>

                                    Wishlist

                                    <span class="ever-mobile-count"
                                          id="mobileWishlistCount">
                                    </span>

                                </a>


                                <!-- SHOPPING BAG -->

                                <a class="ever-mobile-link"
                                     asp-controller="Products"
                                     asp-action="Cart">

                                    <span class="ever-mobile-icon">
                                        🛍
                                    </span>

                                    Shopping Bag

                                    <span class="ever-mobile-count"
                                          id="mobileCartCount">
                                    </span>

                                </a>


                                <!-- ADMIN -->

                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="ever-mobile-link"
                                       asp-controller="Admin"
                                       asp-action="Index">

                                        <span class="ever-mobile-icon">
                                            ⚙
                                        </span>

                                        Admin Dashboard

                                    </a>
                                }


                                <!-- =====================================
                                     ACCOUNT / LOGIN / LOGOUT
                                     ===================================== -->

                                @if (User.Identity?.IsAuthenticated == true)
                                {

                                    <!-- ACCOUNT -->

                                    <a class="ever-mobile-link"
                                       asp-controller="Account"
                                       asp-action="Profile">

                                        <span class="ever-mobile-icon">
                                            ♙
                                        </span>

                                        My Account

                                    </a>


                                    <!-- LOGOUT -->

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        <button type="submit"
                                                class="ever-mobile-link">

                                            <span class="ever-mobile-icon">
                                                ↪
                                            </span>

                                            Logout

                                        </button>

                                    </form>

                                }
                                else
                                {

                                    <!-- LOGIN -->

                                    <a class="ever-mobile-link"
                                       asp-controller="Account"
                                       asp-action="Login">

                                        <span class="ever-mobile-icon">
                                            ♙
                                        </span>

                                        Login

                                    </a>

                                }


                            </div>


                            <!-- =========================================
                                 MOBILE CATEGORIES
                                 ========================================= -->

                            <div class="ever-mobile-categories">

                                <p class="ever-mobile-menu-heading">
                                    SHOP BY CATEGORY
                                </p>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="new-arrivals">

                                    New Arrivals

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="women">

                                    Women's Collection

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="men">

                                    Men's Collection

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="kurti">

                                    Kurti

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="saree">

                                    Saree

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="accessories">

                                    Accessories

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="skincare">

                                    Skincare

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="makeup">

                                    Makeup

                                </a>


                                <a asp-controller="Products"
                                   asp-action="Category"
                                   asp-route-id="offers">

                                    Offers

                                </a>

                            </div>


                        </div>


                    </div>

                </div>

            </nav>


            <!-- =====================================================
                 DESKTOP CATEGORY BAR
                 ===================================================== -->

            <div class="ever-category-bar">

                <div class="container">

                    <nav class="ever-category-links"
                         aria-label="Shop categories">


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="new-arrivals">

                            New Arrivals

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="women">

                            Women's Collection

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="men">

                            Men's Collection

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="kurti">

                            Kurti

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="saree">

                            Saree

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="accessories">

                            Accessories

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="skincare">

                            Skincare

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="makeup">

                            Makeup

                        </a>


                        <a asp-controller="Products"
                           asp-action="Category"
                           asp-route-id="offers">

                            Offers

                        </a>


                    </nav>

                </div>

            </div>


        </div>

    </header>
    </div>



    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="ever-footer">

        <div class="container">

            <div class="ever-footer-content">


                <a class="ever-footer-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    Ever Spring

                </a>


                <p class="ever-footer-tagline">

                    A little beauty, a little joy,
                    a little something for you.

                </p>


                <div class="ever-footer-links">


                    <a asp-controller="Home"
                       asp-action="Index">

                        Home

                    </a>


                    <a asp-controller="Home"
                       asp-action="Privacy">

                        Privacy

                    </a>


                    <a asp-controller="Account"
                       asp-action="Login">

                        My Account

                    </a>


                </div>


                <small>

                    &copy; @DateTime.Now.Year Ever Spring.
                    All rights reserved.

                </small>


            </div>

        </div>

    </footer>


    <!-- =====================================================
         JAVASCRIPT LIBRARIES
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <!-- =====================================================
         MOBILE MENU + WISHLIST + CART
         ===================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {


            /* =================================================
               MOBILE MENU
               ================================================= */

            const toggle =
                document.getElementById("everMenuToggle");

            const menu =
                document.getElementById("everMobileMenu");


            if (toggle && menu) {


                function closeMenu() {

                    menu.classList.remove("is-open");

                    toggle.classList.remove("is-open");

                    toggle.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    toggle.setAttribute(
                        "aria-label",
                        "Open navigation menu"
                    );

                }


                toggle.addEventListener(
                    "click",
                    function () {

                        const isOpen =
                            menu.classList.toggle("is-open");


                        toggle.classList.toggle(
                            "is-open",
                            isOpen
                        );


                        toggle.setAttribute(
                            "aria-expanded",
                            String(isOpen)
                        );


                        toggle.setAttribute(
                            "aria-label",
                            isOpen
                                ? "Close navigation menu"
                                : "Open navigation menu"
                        );

                    }
                );


                /* Close menu after clicking a link */

                menu.querySelectorAll("a")
                    .forEach(function (link) {

                        link.addEventListener(
                            "click",
                            closeMenu
                        );

                    });


                /* Close menu when returning to desktop */

                window.addEventListener(
                    "resize",
                    function () {

                        if (window.innerWidth > 768) {

                            closeMenu();

                        }

                    }
                );

            }


            /* =================================================
               STORAGE KEYS
               ================================================= */

            const WISHLIST_KEY =
                "everSpringWishlist";

            const CART_KEY =
                "everSpringCart";


            /* =================================================
               NAVBAR COUNTERS
               ================================================= */

            const wishlistCount =
                document.getElementById("wishlistCount");

            const cartCount =
                document.getElementById("cartCount");

            const mobileWishlistCount =
                document.getElementById(
                    "mobileWishlistCount"
                );

            const mobileCartCount =
                document.getElementById(
                    "mobileCartCount"
                );


            /* =================================================
               GET WISHLIST
               ================================================= */

            function getWishlistItems() {

                try {

                    const data =
                        localStorage.getItem(
                            WISHLIST_KEY
                        );


                    if (!data) {

                        return [];

                    }


                    const items =
                        JSON.parse(data);


                    return Array.isArray(items)
                        ? items
                        : [];

                }
                catch (error) {

                    console.error(
                        "Wishlist read error:",
                        error
                    );

                    return [];

                }

            }


            /* =================================================
               SAVE WISHLIST
               ================================================= */

            function saveWishlistItems(items) {

                localStorage.setItem(
                    WISHLIST_KEY,
                    JSON.stringify(items)
                );

                updateCounters();

            }


            /* =================================================
               GET CART
               ================================================= */

            function getCartItems() {

                try {

                    const data =
                        localStorage.getItem(
                            CART_KEY
                        );


                    if (!data) {

                        return [];

                    }


                    const items =
                        JSON.parse(data);


                    return Array.isArray(items)
                        ? items
                        : [];

                }
                catch (error) {

                    console.error(
                        "Cart read error:",
                        error
                    );

                    return [];

                }

            }


            /* =================================================
               SAVE CART
               ================================================= */

            function saveCartItems(items) {

                localStorage.setItem(
                    CART_KEY,
                    JSON.stringify(items)
                );

                updateCounters();

            }


            /* =================================================
               UPDATE NAVBAR COUNTERS
               ================================================= */

            function updateCounters() {


                const wishlist =
                    getWishlistItems();


                const cart =
                    getCartItems();


                /* =============================================
                   WISHLIST COUNT
                   ============================================= */

                if (wishlistCount) {

                    if (wishlist.length > 0) {

                        wishlistCount.textContent =
                            wishlist.length;

                        wishlistCount.style.display =
                            "flex";

                    }
                    else {

                        wishlistCount.textContent =
                            "";

                        wishlistCount.style.display =
                            "none";

                    }

                }


                /* Mobile Wishlist */

                if (mobileWishlistCount) {

                    if (wishlist.length > 0) {

                        mobileWishlistCount.textContent =
                            wishlist.length;

                        mobileWishlistCount.style.display =
                            "inline-flex";

                    }
                    else {

                        mobileWishlistCount.textContent =
                            "";

                        mobileWishlistCount.style.display =
                            "none";

                    }

                }


                /* =============================================
                   CART COUNT
                   ============================================= */

                const totalCartQuantity =
                    cart.reduce(
                        function (total, item) {

                            return total +
                                Number(
                                    item.quantity || 1
                                );

                        },
                        0
                    );


                /* Desktop Cart */

                if (cartCount) {

                    if (totalCartQuantity > 0) {

                        cartCount.textContent =
                            totalCartQuantity;

                        cartCount.style.display =
                            "flex";

                    }
                    else {

                        cartCount.textContent =
                            "";

                        cartCount.style.display =
                            "none";

                    }

                }


                /* Mobile Cart */

                if (mobileCartCount) {

                    if (totalCartQuantity > 0) {

                        mobileCartCount.textContent =
                            totalCartQuantity;

                        mobileCartCount.style.display =
                            "inline-flex";

                    }
                    else {

                        mobileCartCount.textContent =
                            "";

                        mobileCartCount.style.display =
                            "none";

                    }

                }

            }


            /* =================================================
               WISHLIST
               ================================================= */

            window.EverSpringWishlist = {


                /* =============================================
                   ADD
                   ============================================= */

          add: function (product) {

    if (!product || !product.id) {
        return false;
    }

    const wishlist = getWishlistItems();

    const existingItem = wishlist.find(function (item) {

        return Number(item.id) ===
            Number(product.id);

    });


    /* =============================================
       PRODUCT ALREADY EXISTS
       Update product information
       ============================================= */

    if (existingItem) {

        existingItem.name = product.name;
        existingItem.category = product.category;
        existingItem.imageUrl = product.imageUrl;
        existingItem.price = Number(product.price) || 0;

        saveWishlistItems(wishlist);

        return false;
    }


    /* =============================================
       NEW PRODUCT
       ============================================= */

    wishlist.push({

        id: product.id,

        name: product.name,

        category: product.category,

        imageUrl: product.imageUrl,

        price: Number(product.price) || 0

    });


    saveWishlistItems(wishlist);

    return true;
},

                /* =============================================
                   REMOVE
                   ============================================= */

                remove: function (productId) {


                    let wishlist =
                        getWishlistItems();


                    wishlist =
                        wishlist.filter(
                            function (item) {

                                return Number(item.id) !==
                                    Number(productId);

                            }
                        );


                    saveWishlistItems(wishlist);


                    return true;

                },


                /* =============================================
                   CHECK PRODUCT
                   ============================================= */

                has: function (productId) {


                    const wishlist =
                        getWishlistItems();


                    return wishlist.some(
                        function (item) {

                            return Number(item.id) ===
                                Number(productId);

                        }
                    );

                },


                /* =============================================
                   GET ALL
                   ============================================= */

                getAll: function () {

                    return getWishlistItems();

                },


                /* =============================================
                   CLEAR ALL
                   ============================================= */

                clear: function () {

                    localStorage.removeItem(
                        WISHLIST_KEY
                    );

                    updateCounters();

                }

            };


            /* =================================================
               SHOPPING CART
               ================================================= */

         window.EverSpringCart = {

    /* =============================================
       ADD TO CART
       ============================================= */

    add: function (product, quantity = 1) {

        if (!product || !product.id) {
            return false;
        }

        quantity = Number(quantity);

        if (isNaN(quantity) || quantity < 1) {
            quantity = 1;
        }

        const cart = getCartItems();

        /* Find existing product */
        const existingItem = cart.find(function (item) {
            return Number(item.id) === Number(product.id);
        });


        /* =============================================
           IF PRODUCT ALREADY EXISTS
           Update ALL product information
           ============================================= */

        if (existingItem) {

            existingItem.name = product.name;
            existingItem.category = product.category;
            existingItem.imageUrl = product.imageUrl;
            existingItem.price = Number(product.price) || 0;

            existingItem.quantity =
                Number(existingItem.quantity || 0) + quantity;
        }


        /* =============================================
           NEW PRODUCT
           ============================================= */

        else {

            cart.push({

                id: product.id,

                name: product.name,

                category: product.category,

                imageUrl: product.imageUrl,

                price: Number(product.price) || 0,

                quantity: quantity

            });

        }


        saveCartItems(cart);

        return true;
    },


    /* =============================================
       REMOVE
       ============================================= */

    remove: function (productId) {

        let cart = getCartItems();

        cart = cart.filter(function (item) {

            return Number(item.id) !==
                Number(productId);

        });

        saveCartItems(cart);

        return true;
    },


    /* =============================================
       UPDATE QUANTITY
       ============================================= */

    updateQuantity: function (productId, quantity) {

        quantity = Number(quantity);

        let cart = getCartItems();

        const item = cart.find(function (product) {

            return Number(product.id) ===
                Number(productId);

        });


        if (!item) {
            return false;
        }


        /* Remove if quantity is zero */

        if (isNaN(quantity) || quantity <= 0) {

            cart = cart.filter(function (product) {

                return Number(product.id) !==
                    Number(productId);

            });

        }

        else {

            item.quantity = quantity;

        }


        saveCartItems(cart);

        return true;
    },


    /* =============================================
       GET ALL
       ============================================= */

    getAll: function () {

        return getCartItems();

    },


    /* =============================================
       CLEAR CART
       ============================================= */

    clear: function () {

        localStorage.removeItem(CART_KEY);

        updateCounters();

    }

};


            /* =================================================
               INITIAL COUNTER UPDATE
               ================================================= */

            updateCounters();


        });

    </script>


    <!-- =====================================================
         PAGE-SPECIFIC SCRIPTS
         ===================================================== -->

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>