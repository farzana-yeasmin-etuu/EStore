@model EStore.Models.Order

@{
    ViewData["Title"] = "Order Details | Admin";
}

<div class="es-admin-page">


    @if (TempData["SuccessMessage"] != null)
{
    <div class="es-admin-success-message">
        @TempData["SuccessMessage"]
    </div>
}

    <!-- ==========================================
         HEADER
    =========================================== -->

    <div class="es-admin-page-header">

        <div>

            <p class="es-products-small-title">
                EVER SPRING ADMIN
            </p>

            <h1>
                Order Details
            </h1>

            <p>
                @Model.OrderNumber
            </p>

        </div>


        <a asp-controller="Admin"
           asp-action="Orders"
           class="es-admin-back-btn">
            ← Back to Orders
        </a>

    </div>


    <div class="es-admin-order-layout">

        <!-- ==========================================
             CUSTOMER INFORMATION
        =========================================== -->

        <div class="es-admin-order-card">

            <h2>
                Customer Information
            </h2>


            <div class="es-admin-detail-list">

                <div>

                    <span>
                        Name
                    </span>

                    <strong>
                        @Model.CustomerName
                    </strong>

                </div>


                <div>

                    <span>
                        Email
                    </span>

                    <strong>
                        @Model.CustomerEmail
                    </strong>

                </div>


                <div>

                    <span>
                        Phone
                    </span>

                    <strong>
                        @Model.CustomerPhone
                    </strong>

                </div>


                <div>

                    <span>
                        Address
                    </span>

                    <strong>
                        @Model.ShippingAddress
                    </strong>

                </div>


                <div>

                    <span>
                        City
                    </span>

                    <strong>
                        @Model.City
                    </strong>

                </div>


                <div>

                    <span>
                        Post Code
                    </span>

                    <strong>
                        @Model.PostCode
                    </strong>

                </div>

            </div>

        </div>


        <!-- ==========================================
             ORDER INFORMATION
        =========================================== -->

        <div class="es-admin-order-card">

            <h2>
                Order Information
            </h2>


            <div class="es-admin-detail-list">

                <div>

                    <span>
                        Order Number
                    </span>

                    <strong>
                        @Model.OrderNumber
                    </strong>

                </div>


                <div>

                    <span>
                        Order Date
                    </span>

                    <strong>
                        @Model.CreatedAt
                            .ToLocalTime()
                            .ToString("dd MMM yyyy, hh:mm tt")
                    </strong>

                </div>


                <div>

                    <span>
                        Payment
                    </span>

                    <strong>
                        @Model.PaymentStatus
                    </strong>

                </div>


                <div>

                    <span>
                        Order Status
                    </span>

                    <strong>
                        @Model.OrderStatus
                    </strong>

                </div>


                <div>

                    <span>
                        Total
                    </span>

                    <strong>
                        BDT @Model.TotalAmount.ToString("N0")
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- ==========================================
         ORDER ITEMS
    =========================================== -->

    <div class="es-admin-order-card es-admin-items-card">

        <h2>
            Ordered Products
        </h2>


        <div class="es-admin-order-items">

            @foreach (var item in Model.OrderItems)
            {
                <div class="es-admin-order-item">

                    <div class="es-admin-order-item-image">

                        <img src="@item.ImageUrl"
                             alt="@item.ProductName">

                    </div>


                    <div class="es-admin-order-item-info">

                        <h3>
                            @item.ProductName
                        </h3>

                        <p>
                            Unit Price:
                            BDT @item.UnitPrice.ToString("N0")
                        </p>

                        <p>
                            Quantity:
                            @item.Quantity
                        </p>

                    </div>


                    <div class="es-admin-order-item-total">

                        BDT
                        @item.TotalPrice.ToString("N0")

                    </div>

                </div>
            }

        </div>


        <div class="es-admin-order-total">

            <span>
                Order Total
            </span>

            <strong>
                BDT @Model.TotalAmount.ToString("N0")
            </strong>

        </div>

    </div>


    <!-- ==========================================
         ORDER STATUS
    =========================================== -->

    <div class="es-admin-order-card">

        <h2>
            Manage Order
        </h2>


        <form asp-controller="Admin"
              asp-action="UpdateOrderStatus"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />


            <div class="es-admin-status-form">

                <div>

                    <label>
                        Order Status
                    </label>

                    <select name="status"
                            class="es-admin-status-select">

                        <option value="Pending"
                            selected="@(Model.OrderStatus == "Pending")">
                            Pending
                        </option>

                        <option value="Confirmed"
                            selected="@(Model.OrderStatus == "Confirmed")">
                            Confirmed
                        </option>

                        <option value="Processing"
                            selected="@(Model.OrderStatus == "Processing")">
                            Processing
                        </option>

                        <option value="Shipped"
                            selected="@(Model.OrderStatus == "Shipped")">
                            Shipped
                        </option>

                        <option value="Delivered"
                            selected="@(Model.OrderStatus == "Delivered")">
                            Delivered
                        </option>

                        <option value="Cancelled"
                            selected="@(Model.OrderStatus == "Cancelled")">
                            Cancelled
                        </option>

                    </select>

                </div>


                <button type="submit"
                        class="es-admin-save-btn">

                    Update Status

                </button>

            </div>

        </form>

    </div>

</div>