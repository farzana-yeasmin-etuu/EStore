@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Admin Dashboard</h1>
        <p class="text-muted">
            Welcome to Ever Spring administration panel
        </p>
    </div>

    <div class="row g-4">

        <!-- Products -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">

                    <div class="mb-3" style="font-size: 40px;">
                        🛍️
                    </div>

                    <h4 class="fw-bold">
                        Products
                    </h4>

                    <p class="text-muted">
                        Add, edit, delete and manage products.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="btn btn-dark">
                        Manage Products
                    </a>

                </div>
            </div>
        </div>


        <!-- Page Visits -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">

                    <div class="mb-3" style="font-size: 40px;">
                        📊
                    </div>

                    <h4 class="fw-bold">
                        Page Visits
                    </h4>

                    <p class="text-muted">
                        View customer and visitor activity.
                    </p>

                    <button class="btn btn-outline-dark" disabled>
                        Coming Soon
                    </button>

                </div>
            </div>
        </div>


        <!-- Orders -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">

                    <div class="mb-3" style="font-size: 40px;">
                        📦
                    </div>

                    <h4 class="fw-bold">
                        Orders
                    </h4>

                    <p class="text-muted">
                        Manage customer orders.
                    </p>

                    <button class="btn btn-outline-dark" disabled>
                        Coming Soon
                    </button>

                </div>
            </div>
        </div>

    </div>

</div>