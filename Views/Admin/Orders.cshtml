@{
    ViewData["Title"] = "Orders | Admin";
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

<div class="es-admin-page">

    <div class="es-admin-page-header">

        <div>
            <p class="es-products-small-title">
                EVER SPRING ADMIN
            </p>

            <h1>
                Orders
            </h1>

            <p>
                View and manage customer orders.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="es-admin-back-btn">
            ← Dashboard
        </a>

    </div>

    <div class="es-admin-table-card">

        <partial name="_OrdersTable" />

    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="~/js/admin-orders-table.js" asp-append-version="true"></script>
}