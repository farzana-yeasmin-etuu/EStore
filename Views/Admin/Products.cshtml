@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    ViewData["Title"] = "Manage Products";

    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Manage Products
            </h1>

            <p class="text-muted mb-0">
                Add, edit and manage Ever Spring products.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

                        @* Developer tools: only visible while developing on your own computer *@
            @if (Env.IsDevelopment())
            {
                <a asp-controller="Admin"
                   asp-action="ImageManager"
                   class="btn btn-outline-dark">
                    🖼 Manage Image Names
                </a>

                <form asp-controller="Admin"
                      asp-action="RenameProductImages"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to rename all product images using their product names?');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-outline-dark">
                        Rename Images
                    </button>

                </form>
            }
           

               

            <a asp-controller="Admin"
               asp-action="CreateProduct"
               class="btn btn-dark px-4">
                + Add Product
            </a>

        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- Product Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @* One token for the table's AJAX call and the Activate/Deactivate forms *@
            @Html.AntiForgeryToken()

            <!-- Filters -->
            <div class="row g-2 mb-3">

                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">Category</label>
                    <select id="fCategory" class="form-select">
                        <option value="">All categories</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">Status</label>
                    <select id="fStatus" class="form-select">
                        <option value="">All</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <div class="col-6 col-md-3">
                    <label class="form-label small mb-1">Stock</label>
                    <select id="fStock" class="form-select">
                        <option value="">All</option>
                        <option value="Low">Low stock (5 or less)</option>
                        <option value="Out">Out of stock</option>
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex align-items-end">
                    <button type="button" id="btnReset" class="btn btn-outline-secondary w-100">
                        Reset
                    </button>
                </div>

            </div>

            <div class="table-responsive">

                <table id="productsTable"
                       class="table table-hover align-middle w-100"
                       data-url="@Url.Action("ProductsData", "Admin")">

                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="~/js/admin-products-table.js" asp-append-version="true"></script>
}