@model EStore.ViewModels.AdminProductViewModel

@{
    ViewData["Title"] = "Add Product";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="mb-4">

                <a asp-controller="Admin"
                   asp-action="Products"
                   class="text-decoration-none text-muted">

                    ← Back to Products

                </a>

                <h1 class="fw-bold mt-3">
                    Add Product
                </h1>

                <p class="text-muted">
                    Add a new product to Ever Spring.
                </p>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <form asp-action="CreateProduct"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Product Name -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Example: Black Printed Kurti" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Category -->
                        <div class="mb-4">

                            <label asp-for="Category"
                                   class="form-label fw-semibold">
                                Category
                            </label>

                            <select asp-for="Category"
                                    class="form-select">

                                <option value="">
                                    -- Select Category --
                                </option>

                                <option value="New Arrivals">
                                    New Arrivals
                                </option>

                                <option value="Women's Collection">
                                    Women's Collection
                                </option>

                                <option value="Men's Collection">
                                    Men's Collection
                                </option>

                                <option value="Kurti">
                                    Kurti
                                </option>

                                <option value="Saree">
                                    Saree
                                </option>

                                <option value="Accessories">
                                    Accessories
                                </option>

                                <option value="Skincare">
                                    Skincare
                                </option>

                                <option value="Makeup">
                                    Makeup
                                </option>

                                <option value="Offers">
                                    Offers
                                </option>

                            </select>

                            <span asp-validation-for="Category"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Price + Stock -->
                        <div class="row">

                            <div class="col-md-6 mb-4">

                                <label asp-for="Price"
                                       class="form-label fw-semibold">
                                    Price (BDT)
                                </label>

                                <input asp-for="Price"
                                       type="number"
                                       step="0.01"
                                       class="form-control"
                                       placeholder="1200" />

                                <span asp-validation-for="Price"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-4">

                                <label asp-for="Stock"
                                       class="form-label fw-semibold">
                                    Stock
                                </label>

                                <input asp-for="Stock"
                                       type="number"
                                       class="form-control"
                                       placeholder="10" />

                                <span asp-validation-for="Stock"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Description -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write product description...">
                            </textarea>

                        </div>


                        <!-- Image -->
                        <div class="mb-4">

                            <label asp-for="ImageFile"
                                   class="form-label fw-semibold">
                                Product Image
                            </label>

                            <input asp-for="ImageFile"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp" />

                            <div class="form-text">
                                JPG, JPEG, PNG or WEBP only.
                            </div>

                            <span asp-validation-for="ImageFile"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Active -->
                        <div class="form-check mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">

                                Product is active

                            </label>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-dark px-4">

                                Add Product

                            </button>

                            <a asp-controller="Admin"
                               asp-action="Products"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}