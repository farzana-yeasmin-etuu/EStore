@model EStore.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="es-auth-page">

    <div class="es-auth-card es-register-card">

       

        <!-- Heading -->
        <div class="es-auth-header">

            <h1>Create Your Account</h1>

            <p>
                Join Ever Spring and discover something lovely.
            </p>

        </div>

        <form asp-action="Register"
              method="post"
              class="es-auth-form">

            <!-- Validation Summary -->
            <div asp-validation-summary="All"
                 class="es-auth-validation-summary">
            </div>

            <!-- Full Name -->
            <div class="es-form-group">

                <label asp-for="FullName"
                       class="es-form-label">
                </label>

                <input asp-for="FullName"
                       class="es-form-control"
                       placeholder="Enter your full name"
                       autocomplete="name" />

                <span asp-validation-for="FullName"
                      class="es-validation-message">
                </span>

            </div>

            <!-- Email -->
            <div class="es-form-group">

                <label asp-for="Email"
                       class="es-form-label">
                </label>

                <input asp-for="Email"
                       class="es-form-control"
                       placeholder="Enter your email"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="es-validation-message">
                </span>

            </div>

            <!-- Password -->
            <div class="es-form-group">

                <label asp-for="Password"
                       class="es-form-label">
                </label>

                <input asp-for="Password"
                       class="es-form-control"
                       placeholder="Create a password"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="es-validation-message">
                </span>

            </div>

            <!-- Confirm Password -->
            <div class="es-form-group">

                <label asp-for="ConfirmPassword"
                       class="es-form-label">
                </label>

                <input asp-for="ConfirmPassword"
                       class="es-form-control"
                       placeholder="Confirm your password"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="es-validation-message">
                </span>

            </div>

            <!-- Register Button -->
            <button type="submit"
                    class="es-auth-button">
                Create Account
                <span>→</span>
            </button>

        </form>

        <!-- Login Link -->
        <div class="es-auth-switch">

            <span>Already have an account?</span>

            <a asp-action="Login">
                Login
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}