@model EStore.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile | Ever Spring";
}

<style>
    .pf-card { background: #fff; border-radius: 16px; padding: 24px;
               box-shadow: 0 2px 12px rgba(0,0,0,.06); margin-bottom: 20px; }
    .pf-card h5 { font-weight: 700; margin: 0 0 4px; }
    .pf-sub { color: #777; font-size: 14px; margin-bottom: 18px; }

    .pf-avatar { width: 84px; height: 84px; border-radius: 50%;
                 background: #a85c78; color: #fff; font-size: 30px; font-weight: 700;
                 display: flex; align-items: center; justify-content: center;
                 margin: 0 auto 12px; }

    .pf-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 18px 0; }
    .pf-stat { background: #faf6f8; border-radius: 12px; padding: 12px; text-align: center; }
    .pf-stat strong { display: block; font-size: 20px; }
    .pf-stat span { font-size: 12px; color: #777; }

    .pf-order { display: flex; justify-content: space-between; align-items: center;
                gap: 12px; padding: 12px 0; border-bottom: 1px solid #f1f1f1; }
    .pf-order:last-child { border-bottom: 0; }
    .pf-order a { color: #111; font-weight: 600; text-decoration: none; }
    .pf-order small { color: #888; }
</style>

<div class="container py-5">

    <div class="row g-4">

        <!-- ================= LEFT: SUMMARY ================= -->
        <div class="col-lg-4">

            <div class="pf-card text-center">

                <div class="pf-avatar">@Model.Initials</div>

                <h5>@Model.FullName</h5>
                <div class="text-muted" style="word-break:break-all;">@Model.Email</div>

                <div class="pf-stats">

                    <div class="pf-stat">
                        <strong>@Model.TotalOrders</strong>
                        <span>Orders</span>
                    </div>

                    <div class="pf-stat">
                        <strong>@Model.ActiveOrders</strong>
                        <span>On the way</span>
                    </div>

                    <div class="pf-stat">
                        <strong>@Model.WishlistCount</strong>
                        <span>Wishlist</span>
                    </div>

                    <div class="pf-stat">
                        <strong>BDT @Model.TotalSpent.ToString("N0")</strong>
                        <span>Total spent</span>
                    </div>

                </div>

                <div class="d-grid gap-2">
                    <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-dark">
                        My Orders
                    </a>
                    <a asp-controller="Products" asp-action="Wishlist" class="btn btn-outline-dark">
                        My Wishlist
                    </a>
                </div>

            </div>

        </div>


        <!-- ================= RIGHT: FORMS ================= -->
        <div class="col-lg-8">

            <!-- Personal information -->
            <div class="pf-card">

                <h5>Personal information</h5>
                <p class="pf-sub">Your delivery address is used to fill the checkout form for you.</p>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert alert-success">@TempData["ProfileSuccess"]</div>
                }

                <form asp-action="UpdateProfile" method="post">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Profile.FullName" class="form-label"></label>
                            <input asp-for="Profile.FullName" class="form-control" />
                            <span asp-validation-for="Profile.FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control" value="@Model.Email" disabled />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Profile.PhoneNumber" class="form-label"></label>
                            <input asp-for="Profile.PhoneNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="Profile.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Profile.Address" class="form-label"></label>
                            <textarea asp-for="Profile.Address" class="form-control" rows="2"
                                      placeholder="House, Road, Area"></textarea>
                            <span asp-validation-for="Profile.Address" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Profile.City" class="form-label"></label>
                            <input asp-for="Profile.City" class="form-control" placeholder="Dhaka" />
                            <span asp-validation-for="Profile.City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Profile.PostCode" class="form-label"></label>
                            <input asp-for="Profile.PostCode" class="form-control" placeholder="1212" />
                            <span asp-validation-for="Profile.PostCode" class="text-danger small"></span>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-dark mt-4 px-4">
                        Save changes
                    </button>

                </form>

            </div>


            <!-- Recent orders -->
            <div class="pf-card">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Recent orders</h5>
                    <a asp-controller="Orders" asp-action="MyOrders" class="small">View all</a>
                </div>

                @if (!Model.RecentOrders.Any())
                {
                    <p class="text-muted mb-0 mt-3">
                        You have not placed any orders yet.
                        <a asp-controller="Home" asp-action="Index">Start shopping</a>
                    </p>
                }
                else
                {
                    foreach (var o in Model.RecentOrders)
                    {
                        <div class="pf-order">

                            <div>
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">
                                    @o.OrderNumber
                                </a><br />
                                <small>@o.Date</small>
                            </div>

                            <div class="text-end">
                                <strong>BDT @o.TotalAmount.ToString("N0")</strong><br />
                                <span class="es-status-badge @(o.OrderStatus == "Cancelled" ? "es-status-cancelled" : o.OrderStatus == "Pending" ? "es-status-pending" : "es-status-confirmed")">
                                    @o.OrderStatus
                                </span>
                            </div>

                        </div>
                    }
                }

            </div>


            <!-- Change password -->
            <div class="pf-card">

                <h5>Change password</h5>
                <p class="pf-sub">Use a strong password that you do not use anywhere else.</p>

                @if (TempData["PasswordSuccess"] != null)
                {
                    <div class="alert alert-success">@TempData["PasswordSuccess"]</div>
                }

                <form asp-action="ChangePassword" method="post">

                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="Password.CurrentPassword" class="form-label"></label>
                            <input asp-for="Password.CurrentPassword" class="form-control"
                                   autocomplete="current-password" />
                            <span asp-validation-for="Password.CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password.NewPassword" class="form-label"></label>
                            <input asp-for="Password.NewPassword" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password.NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                            <input asp-for="Password.ConfirmPassword" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password.ConfirmPassword" class="text-danger small"></span>
                        </div>

                    </div>

                    <button type="submit" class="btn btn-outline-dark mt-4 px-4">
                        Update password
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>