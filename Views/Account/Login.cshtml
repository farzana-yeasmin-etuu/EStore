@model EStore.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="es-auth-page">

    <div class="es-auth-card">

       

        <!-- Heading -->
        <div class="es-auth-header">
            <h1>Welcome Back</h1>
            <p>Sign in to continue your Ever Spring journey.</p>
        </div>

        <form asp-action="Login" method="post" class="es-auth-form">

            <!-- Validation Summary -->
            <div asp-validation-summary="All"
                 class="es-auth-validation-summary">
            </div>

            <!-- Email -->
            <div class="es-form-group">

                <label asp-for="Email"
                       class="es-form-label">
                </label>

                <input asp-for="Email"
                       class="es-form-control"
                       placeholder="Enter your email"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="es-validation-message">
                </span>

            </div>

            <!-- Password -->
            <div class="es-form-group">

                <div class="es-label-row">
                    <label asp-for="Password"
                           class="es-form-label">
                    </label>
                </div>

                <input asp-for="Password"
                       class="es-form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <span asp-validation-for="Password"
                      class="es-validation-message">
                </span>

            </div>

            <!-- Remember Me -->
            <div class="es-remember-row">

                <div class="es-custom-check">

                    <input asp-for="RememberMe"
                           id="rememberMe"
                           class="es-check-input" />

                    <label asp-for="RememberMe"
                           for="rememberMe"
                           class="es-check-label">
                    </label>

                </div>

            </div>

            <!-- Login Button -->
            <button type="submit"
                    class="es-auth-button">
                Login
                <span>→</span>
            </button>

        </form>

        <!-- Register Link -->
        <div class="es-auth-switch">
            <span>Don't have an account?</span>

            <a asp-action="Register">
                Create one
            </a>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}