@model List<EStore.ViewModels.ProductViewModel>

@{
    var categoryName = ViewBag.CategoryName as string ?? "Products";
    ViewData["Title"] = categoryName + " | Ever Spring";
}

<div class="es-products-page">

    <!-- Page Header -->
    <div class="es-products-header">

        <div>
            <p class="es-products-small-title">
                EVER SPRING
            </p>

            <h1>
                @ViewBag.CategoryName
            </h1>

            <p>
                Discover our beautiful collection curated just for you.
            </p>
        </div>

    </div>


    <!-- Products -->
    <div class="es-product-grid">

        @if (Model != null && Model.Count > 0)
        {
            foreach (var product in Model)
            {
                <div class="es-product-card">

                    <!-- Product Image -->
                    <div class="es-product-image-wrapper">

                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="text-decoration-none">

                            <img src="@product.ImageUrl"
                                 alt="@product.Name"
                                 class="w-100"
                                 style="object-fit:contain;">

                        </a>


                        <!-- Wishlist -->
                        <button type="button"
                                class="es-product-wishlist"
                                data-product-id="@product.Id"
                                data-product-name="@product.Name"
                                data-product-category="@product.Category"
                                data-product-image="@product.ImageUrl"
                                data-product-price="@product.Price"
                                onclick="addCategoryProductToWishlist(this)"
                                aria-label="Add to wishlist">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8">

                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z">
                                </path>

                            </svg>

                        </button>

                    </div>


                    <!-- Product Information -->
                    <div class="es-product-info">

                        <p class="es-product-category">
                            @product.Category
                        </p>

                        <h3>
                            @product.Name
                        </h3>

                        <div class="es-product-bottom">

                            <!-- PRICE -->
                            <span class="es-product-price">
                                BDT @product.Price.ToString("N0")
                            </span>


                            <!-- ADD TO BAG -->
                            <button type="button"
                                    class="es-add-bag-btn"
                                    data-product-id="@product.Id"
                                    data-product-name="@product.Name"
                                    data-product-category="@product.Category"
                                    data-product-image="@product.ImageUrl"
                                    data-product-price="@product.Price"
                                    onclick="addCategoryProductToCart(this)">

                                Add to Bag

                            </button>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="es-no-products">

                <h3>No products found</h3>

                <p>
                    Products will be added soon.
                </p>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        /* =========================================================
           CREATE PRODUCT OBJECT
           ========================================================= */

        function getCategoryProduct(button) {

            return {

                id: button.dataset.productId,

                name: button.dataset.productName,

                category: button.dataset.productCategory,

                imageUrl: button.dataset.productImage,

                price: Number(button.dataset.productPrice) || 0

            };

        }


        /* =========================================================
           ADD TO WISHLIST
           ========================================================= */

        function addCategoryProductToWishlist(button) {

            const product =
                getCategoryProduct(button);


            console.log("Wishlist Product:", product);


            if (window.EverSpringWishlist &&
                typeof window.EverSpringWishlist.add === "function") {

                window.EverSpringWishlist.add(product);

                alert(
                    product.name +
                    " added to your wishlist."
                );

            }
            else {

                alert(
                    "Wishlist is not available."
                );

            }

        }


        /* =========================================================
           ADD TO CART
           ========================================================= */

        function addCategoryProductToCart(button) {

            const product =
                getCategoryProduct(button);


            console.log("Cart Product:", product);


            if (window.EverSpringCart &&
                typeof window.EverSpringCart.add === "function") {

                window.EverSpringCart.add(
                    product,
                    1
                );

                alert(
                    product.name +
                    " added to your bag."
                );

            }
            else {

                alert(
                    "Shopping bag is not available."
                );

            }

        }

    </script>

}