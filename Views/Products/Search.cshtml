@model IEnumerable<EStore.ViewModels.ProductViewModel>

@{
    ViewData["Title"] = "Search Products";

    var currentQuery = Context.Request.Query["q"].ToString();
    var currentCategory = Context.Request.Query["category"].ToString();

    string categoryTitle = string.IsNullOrWhiteSpace(currentCategory)
        ? "All Products"
        : currentCategory;
}

<div class="es-search-page">

    <!-- =========================
         SEARCH HEADER
         ========================= -->
    <section class="es-search-header">

        <div class="container">

            <div class="es-search-title">

                <span class="es-search-small-title">
                    EVER SPRING
                </span>

                <h1>
                    Search Products
                </h1>

                @if (!string.IsNullOrWhiteSpace(currentQuery))
                {
                    <p>
                        Showing results for
                        <strong>"@currentQuery"</strong>
                    </p>
                }
                else
                {
                    <p>
                        Find your favorite products
                    </p>
                }

            </div>

            <!-- SEARCH BOX -->
            <form asp-controller="Products"
                  asp-action="Search"
                  method="get"
                  class="es-main-search-form">

                <input type="text"
                       name="q"
                       value="@currentQuery"
                       placeholder="Search products..."
                       autocomplete="off" />

                @if (!string.IsNullOrWhiteSpace(currentCategory))
                {
                    <input type="hidden"
                           name="category"
                           value="@currentCategory" />
                }

                <button type="submit">
                    <i class="bi bi-search"></i>
                    Search
                </button>

            </form>

        </div>

    </section>


    <!-- =========================
         SEARCH RESULTS
         ========================= -->
    <section class="es-search-results">

        <div class="container">

            <div class="es-search-result-top">

                <div>
                    <h2>
                        @categoryTitle
                    </h2>

                    <p>
                        @Model.Count() product(s) found
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(currentCategory))
                {
                    <a asp-controller="Products"
                       asp-action="Category"
                       asp-route-id="@currentCategory"
                       class="es-back-category">
                        ← Back to Category
                    </a>
                }

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="es-product-grid">

                    @foreach (var product in Model)
                    {
                        <article class="es-product-card">

                            <!-- IMAGE -->
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="es-product-image-link">

                                <div class="es-product-image-wrap">

                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         class="es-product-image" />

                                </div>

                            </a>


                            <!-- PRODUCT INFO -->
                            <div class="es-product-info">

                                <span class="es-product-category">
                                    @product.Category
                                </span>

                                <h3 class="es-product-name">

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id">

                                        @product.Name

                                    </a>

                                </h3>

                                <div class="es-product-bottom">

                                    <span class="es-product-price">
                                        ৳@product.Price.ToString("N0")
                                    </span>

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="es-view-product">
                                        View
                                    </a>

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <!-- =========================
                     NO RESULT
                     ========================= -->

                <div class="es-no-search-result">

                    <div class="es-no-result-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h2>
                        No products found
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(currentQuery))
                    {
                        <p>
                            We couldn't find any product matching
                            <strong>"@currentQuery"</strong>.
                        </p>
                    }
                    else
                    {
                        <p>
                            Try searching for a product name or category.
                        </p>
                    }

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="es-search-home-btn">
                        Continue Shopping
                    </a>

                </div>
            }

        </div>

    </section>

</div>