@model List<EStore.ViewModels.WishlistItemViewModel>

@{
    ViewData["Title"] = "My Wishlist | Ever Spring";
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">

        <h1 class="fw-bold">
            My Wishlist
        </h1>

        <p class="text-muted">
            Your favourite Ever Spring products
        </p>

    </div>


    <!-- WISHLIST PRODUCTS -->
    <div id="wishlistContainer" class="row g-4">

        @foreach (var p in Model)
        {
            var unavailable = !p.IsActive || p.Stock <= 0;

            <div class="col-12 col-sm-6 col-lg-4 col-xl-3"
                 data-wishlist-card
                 data-id="@p.Id"
                 data-name="@p.Name"
                 data-category="@p.Category"
                 data-image="@p.ImageUrl"
                 data-price="@p.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="p-3">
                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@p.Id">

                            <div style="height:280px; background:#f8f8f8; border-radius:14px; overflow:hidden;">
                                <img src="@p.ImageUrl"
                                     alt="@p.Name"
                                     style="width:100%; height:100%; object-fit:contain;" />
                            </div>

                        </a>
                    </div>

                    <div class="card-body pt-0">

                        <div class="small text-muted mb-1">
                            @p.Category
                        </div>

                        <h5 class="fw-semibold">
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@p.Id"
                               class="text-decoration-none text-dark">
                                @p.Name
                            </a>
                        </h5>

                        <div class="fw-bold mb-3" style="color:#a85c78;">
                            BDT @p.Price.ToString("N0")
                        </div>

                        <div class="d-flex gap-2">

                            @if (unavailable)
                            {
                                <button type="button"
                                        class="btn btn-secondary flex-grow-1"
                                        disabled>
                                    @(p.IsActive ? "Out of stock" : "Unavailable")
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-dark flex-grow-1"
                                        onclick="moveToBag(this)">
                                    Add to Bag
                                </button>
                            }

                            <button type="button"
                                    class="btn btn-outline-danger"
                                    onclick="removeFromWishlist(this)"
                                    title="Remove from wishlist">
                                ♡
                            </button>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- EMPTY WISHLIST -->
    <div id="emptyWishlist"
         class="text-center py-5"
         style="display:@(Model.Any() ? "none" : "block");">

        <div style="font-size:60px;">
            ♡
        </div>

        <h3 class="fw-bold mt-3">
            Your wishlist is empty
        </h3>

        <p class="text-muted">
            Save your favourite products here.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-dark px-4 mt-2">
            Continue Shopping
        </a>

    </div>

</div>


@section Scripts
{
    <script>

        // ============================================
        // REMOVE FROM WISHLIST
        // ============================================

        function removeFromWishlist(button) {

            const card = button.closest("[data-wishlist-card]");

            if (!card) {
                return;
            }

            // Saves to the database and updates the navbar count
            window.EverSpringWishlist.remove(card.dataset.id);

            card.remove();

            if (!document.querySelector("[data-wishlist-card]")) {
                document.getElementById("emptyWishlist").style.display = "block";
            }
        }


        // ============================================
        // MOVE TO BAG
        // ============================================

        function moveToBag(button) {

            const card = button.closest("[data-wishlist-card]");

            if (!card) {
                return;
            }

            const product = {
                id: Number(card.dataset.id),
                name: card.dataset.name,
                category: card.dataset.category,
                imageUrl: card.dataset.image,
                price: Number(card.dataset.price) || 0
            };

            if (window.EverSpringCart && window.EverSpringCart.add) {

                window.EverSpringCart.add(product, 1);

                alert(product.name + " added to your bag.");

            }
            else {

                alert("Shopping bag is not available.");
            }
        }

    </script>
}