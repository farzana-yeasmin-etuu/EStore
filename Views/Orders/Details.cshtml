@model EStore.Models.Order

@{
    ViewData["Title"] = "Order Details | Ever Spring";

    string[] trackingStatuses =
    {
        "Pending",
        "Confirmed",
        "Processing",
        "Shipped",
        "Delivered"
    };

    int currentStatusIndex =
        Array.IndexOf(
            trackingStatuses,
            Model.OrderStatus
        );
}

<div class="es-checkout-page">

    <div class="es-checkout-header">

        <p class="es-products-small-title">
            EVER SPRING
        </p>

        <h1>
            Order Placed
        </h1>

        <p>
            Thank you for shopping with Ever Spring.
        </p>

    </div>


    <div class="es-checkout-layout">

        <!-- ORDER INFORMATION -->

        <div class="es-checkout-form-card">

            <h2>
                Order Information
            </h2>

            <div style="margin-top: 25px;">

                <p>
                    <strong>Order Number:</strong>
                    @Model.OrderNumber
                </p>

                <p>
                    <strong>Order Date:</strong>
                    @Model.CreatedAt.ToLocalTime()
                </p>

                <p>
                    <strong>Payment Status:</strong>
                    @Model.PaymentStatus
                </p>

                <div class="es-order-tracking">

                    <div class="es-tracking-header">
                        <div>
                            <span class="es-tracking-eyebrow">
                                ORDER TRACKING
                            </span>

                            <h3>
                                Track Your Order
                            </h3>

                            <p>
                                Current status:
                                <strong>@Model.OrderStatus</strong>
                            </p>
                        </div>
                    </div>


                    @if (Model.OrderStatus == "Cancelled")
                    {
                        <div class="es-tracking-cancelled">
                            <span>✕</span>

                            <div>
                                <strong>Order Cancelled</strong>

                                <p>
                                    This order has been cancelled.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="es-tracking-timeline">

                            @for (int i = 0; i < trackingStatuses.Length; i++)
                            {
                                string status = trackingStatuses[i];

                                string stepClass = "";

                                if (i < currentStatusIndex)
                                {
                                    stepClass = "completed";
                                }
                                else if (i == currentStatusIndex)
                                {
                                    stepClass = "current";
                                }
                                else
                                {
                                    stepClass = "upcoming";
                                }

                                <div class="es-tracking-step @stepClass">

                                    <div class="es-tracking-circle">

                                        @if (i < currentStatusIndex)
                                        {
                                            <span>✓</span>
                                        }
                                        else if (i == currentStatusIndex)
                                        {
                                            <span>●</span>
                                        }
                                        else
                                        {
                                            <span>@(i + 1)</span>
                                        }

                                    </div>

                                    <div class="es-tracking-content">

                                        <strong>
                                            @status
                                        </strong>

                                        @if (i == currentStatusIndex)
                                        {
                                            <span class="es-tracking-current">
                                                Current Status
                                            </span>
                                        }

                                    </div>

                                </div>

                                @if (i < trackingStatuses.Length - 1)
                                {
                                    <div class="es-tracking-line
                                        @(i < currentStatusIndex ? "completed" : "")">
                                    </div>
                                }
                            }

                        </div>
                    }

                </div>

            </div>


            <hr />


            <h3 style="margin-top: 25px;">
                Delivery Information
            </h3>

            <p>
                @Model.CustomerName
            </p>

            <p>
                @Model.CustomerPhone
            </p>

            <p>
                @Model.CustomerEmail
            </p>

            <p>
                @Model.ShippingAddress
            </p>

            <p>
                @Model.City -
                @Model.PostCode
            </p>

        </div>


        <!-- ORDER SUMMARY -->

        <div class="es-checkout-summary-card">

            <h2>
                Your Order
            </h2>


            @foreach (var item in Model.OrderItems)
            {
                <div class="es-checkout-item">

                    <div class="es-checkout-item-image">

                        <img src="@item.ImageUrl"
                             alt="@item.ProductName">

                    </div>


                    <div class="es-checkout-item-info">

                        <h3>
                            @item.ProductName
                        </h3>

                        <p>
                            Qty: @item.Quantity
                        </p>

                        <strong>
                            BDT @item.TotalPrice.ToString("N0")
                        </strong>

                    </div>

                </div>
            }


            <div class="es-checkout-total-line">

                <span>
                    Total
                </span>

                <strong>
                    BDT @Model.TotalAmount.ToString("N0")
                </strong>

            </div>

        </div>

    </div>

</div>